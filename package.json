{
  "name": "drive",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsr generate && bun --bun vite",
    "clean": "rm -rf uploads/* ./dev.db*",
    "build": "vite build",
    "serve": "NODE_ENV=production bun --bun dist/server/server.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "preview": "vite preview",
    "migrate:make": "kysely migrate make",
    "migrate:latest": "kysely migrate latest",
    "migrate:down": "kysely migrate down",
    "auth:check": "auth check schema --config './src/server/auth.ts'",
    "auth:push": "auth migrate",
    "gen:types": "kysely-codegen --dialect sqlite --url ./dev.db --out-file ./src/server/database/types.ts"
  },
