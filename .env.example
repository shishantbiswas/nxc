# Runtime
# Set to production when running outside Docker in production.
# NODE_ENV=production
PORT=3000

# Administrator account created when the database is seeded.
# Set these values before starting a fresh production deployment.
USER_NAME=Drive Admin
USER_EMAIL=admin@example.com
USER_PASSWORD=change-this-password

# Authentication
# Use a long, random value in production.
JWT_SECRET=replace-with-a-long-random-secret
# When unset, the auth guard is enabled in production and disabled otherwise.
ENABLE_GUARD=true

# Database
# Options: libsql, sqlite, postgres, libsql-remote,
# libsql-remote-embedded-replicas
DB_TYPE=libsql
# Used by local database modes. Defaults to data/local.db.
DATABASE_PATH=data/local.db
# Required when DB_TYPE=postgres
POSTGRES_URL=
# Required for libsql-remote and libsql-remote-embedded-replicas
LIBSQL_URL=
LIBSQL_TOKEN=

# File storage
# Options: local, S3
STORAGE_TYPE=local
# Local upload directory
LOCAL_STORAGE_PATH=data/uploads
# Required when STORAGE_TYPE=S3
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_URL_WITH_BUCKET=

# Maximum request/upload body size, in bytes. Defaults to 1 GiB.
MAX_BODY_SIZE=1073741824
